# ---- Gateway ----------------------------------------------------------------
PORT=3000
# Comma-separated client credentials. Each entry is `token` or `token:userId`.
# Leave empty ONLY for local development - the gateway will run unauthenticated
# and log a warning on every connection.
AUTH_TOKENS=change-me-long-random-string:aman
# Comma-separated allowed browser Origins for the WebSocket handshake.
# Leave empty to allow any origin (fine behind a private tunnel, not on the open internet).
ALLOWED_ORIGINS=

# ---- n8n --------------------------------------------------------------------
# The webhook URL of the "Jarvis Chat" entry-point workflow.
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/jarvis-chat
# Sent to n8n as the `x-jarvis-secret` header so the workflow can reject strangers.
N8N_WEBHOOK_SECRET=
# sync  = gateway POSTs and waits for n8n's HTTP response (needs "Respond to Webhook")
# async = gateway POSTs and returns immediately; n8n calls back POST /api/push
N8N_RESPONSE_MODE=sync
# How long to wait for Jarvis before giving up (ms). LLM + tools can be slow.
N8N_TIMEOUT_MS=120000
# Optional dot-path to the reply text in n8n's response, e.g. `data.output`.
# Leave empty to use the built-in auto-detection.
N8N_RESPONSE_PATH=

# ---- Session ----------------------------------------------------------------
# The conversation key handed to n8n, and the key Jarvis memory hangs off.
# Keep it STABLE - the same value on every device and after every reinstall.
# Defaults to `session_<userId>` when left empty.
DEFAULT_SESSION_ID=

# ---- Inbound push (n8n -> gateway -> client) --------------------------------
# Shared secret n8n must send as `x-gateway-secret` when calling POST /api/push.
PUSH_SECRET=another-long-random-string

# ---- Limits -----------------------------------------------------------------
MAX_MESSAGE_BYTES=32768
MAX_INFLIGHT_PER_CONNECTION=4
HEARTBEAT_INTERVAL_MS=30000

# --- Voice ---------------------------------------------------------------
# Off by default. When false the gateway behaves exactly as it did before
# the voice path existed.
VOICE_ENABLED=false

# `gemini` connects a realtime model; `echo` mirrors your microphone back
# with no model and no API key. Echo is the fastest way to tell a broken
# browser audio pipeline from a broken model connection.
VOICE_PROVIDER=gemini
GEMINI_API_KEY=

# A preview model - pin it and expect to change it. Fallback if withdrawn:
# models/gemini-2.5-flash-native-audio-preview-09-2025
VOICE_MODEL=models/gemini-3.1-flash-live-preview
VOICE_NAME=Puck
VOICE_INSTRUCTIONS=

# Memory snapshot for the voice agent. n8n builds it, so the gateway needs no
# database credentials. Preloaded into the session's system instruction at
# start and refreshed on each upstream reconnect, so recall costs nothing per
# turn. Leave blank to run voice without memory.
VOICE_MEMORY_URL=https://n8n-z44q.srv1918051.hstgr.cloud/webhook/voice-memory-snapshot
# Short by intent: this sits between the button press and the session opening.
VOICE_MEMORY_TIMEOUT_MS=2500

# The rates differ by direction: the engine takes 16 kHz and returns 24 kHz.
# One shared rate would sound like chipmunk audio in one direction.
VOICE_INPUT_SAMPLE_RATE=16000
VOICE_OUTPUT_SAMPLE_RATE=24000
VOICE_FRAME_MS=20

# Always-on mode only. Below ~500 ms, a natural mid-sentence pause is read as
# the end of a turn, which fragments the transcript and the reply.
VOICE_SILENCE_MS=700
VOICE_PREFIX_PADDING_MS=300

VOICE_MAX_SESSION_MS=1800000
# Upstream drops a connection roughly every 10 minutes; session resumption
# makes that invisible, but a revoked key never recovers, so reconnects are
# bounded rather than infinite.
VOICE_MAX_RECONNECTS=20
VOICE_MAX_AUDIO_BYTES_PER_SECOND=96000
