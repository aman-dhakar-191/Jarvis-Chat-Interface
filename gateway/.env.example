# ---- Gateway ----------------------------------------------------------------
PORT=3000
# Comma-separated client credentials. Each entry is `token` or `token:userId`.
# Leave empty ONLY for local development - the gateway will run unauthenticated
# and log a warning on every connection.
AUTH_TOKENS=change-me-long-random-string:aman
# Comma-separated allowed browser Origins for the WebSocket handshake.
# Leave empty to allow any origin (fine behind a private tunnel, not on the open internet).
ALLOWED_ORIGINS=

# ---- n8n --------------------------------------------------------------------
# The webhook URL of the "Jarvis Chat" entry-point workflow.
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/jarvis-chat
# Sent to n8n as the `x-jarvis-secret` header so the workflow can reject strangers.
N8N_WEBHOOK_SECRET=
# sync  = gateway POSTs and waits for n8n's HTTP response (needs "Respond to Webhook")
# async = gateway POSTs and returns immediately; n8n calls back POST /api/push
N8N_RESPONSE_MODE=sync
# How long to wait for Jarvis before giving up (ms). LLM + tools can be slow.
N8N_TIMEOUT_MS=120000
# Optional dot-path to the reply text in n8n's response, e.g. `data.output`.
# Leave empty to use the built-in auto-detection.
N8N_RESPONSE_PATH=

# ---- Session ----------------------------------------------------------------
# The conversation key handed to n8n, and the key Jarvis memory hangs off.
# Keep it STABLE - the same value on every device and after every reinstall.
# Defaults to `session_<userId>` when left empty.
DEFAULT_SESSION_ID=

# ---- Inbound push (n8n -> gateway -> client) --------------------------------
# Shared secret n8n must send as `x-gateway-secret` when calling POST /api/push.
PUSH_SECRET=another-long-random-string

# ---- Limits -----------------------------------------------------------------
MAX_MESSAGE_BYTES=32768
MAX_INFLIGHT_PER_CONNECTION=4
HEARTBEAT_INTERVAL_MS=30000
